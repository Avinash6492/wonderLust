<% layout("/layouts/boilerplate") %>

<% const averageRating = listing.reviews.length
  ? (listing.reviews.reduce((total, review) => total + Number(review.rating || 0), 0) / listing.reviews.length).toFixed(1)
  : null; %>

<main class="listing-detail-page">
  <header class="detail-heading">
    <div>
      <p class="detail-eyebrow"><i class="bi bi-geo-alt-fill"></i> <%= listing.location %>, <%= listing.country %></p>
      <h1><%= listing.title %></h1>
      <div class="detail-meta">
        <% if (averageRating) { %>
          <span class="detail-rating"><i class="bi bi-star-fill"></i> <%= averageRating %></span>
          <span class="detail-meta-dot">·</span>
          <a href="#guest-reviews"><%= listing.reviews.length %> reviews</a>
          <span class="detail-meta-dot">·</span>
        <% } else { %>
          <span class="detail-new-badge"><i class="bi bi-stars"></i> New stay</span>
          <span class="detail-meta-dot">·</span>
        <% } %>
        <span><i class="bi bi-pin-map"></i> Great for exploring <%= listing.location %></span>
      </div>
    </div>

    <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
      <div class="detail-owner-actions">
        <a href="/listings/<%= listing._id %>/edit" class="detail-action-button"><i class="bi bi-pencil"></i> Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
          <button type="submit" class="detail-action-button detail-delete-button"><i class="bi bi-trash3"></i> Delete</button>
        </form>
      </div>
    <% } %>
  </header>

  <section class="detail-gallery" aria-label="Listing photo">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %> in <%= listing.location %>">
    <span class="detail-gallery-label"><i class="bi bi-house-heart"></i> A place to feel at home</span>
  </section>

  <div class="detail-content-grid">
    <div class="detail-main-column">
      <section class="host-summary">
        <div class="host-avatar">
          <% if (listing.owner && !listing.owner.accountClosedAt && listing.owner.profileImage && listing.owner.profileImage.url) { %>
            <img src="<%= listing.owner.profileImage.url %>" alt="<%= listing.owner.username %> profile photo">
          <% } else { %>
            <i class="bi bi-person-fill"></i>
          <% } %>
        </div>
        <div>
          <h2>Stay hosted by <%= listing.owner && !listing.owner.accountClosedAt ? listing.owner.username : "a local host" %></h2>
          <p>Welcome to this stay in <%= listing.location %></p>
        </div>
      </section>

      <section class="detail-description-section">
        <h2>About this place</h2>
        <p><%= listing.description %></p>
      </section>

      <section class="detail-highlights">
        <article>
          <i class="bi bi-geo-alt"></i>
          <div><h3>Explore the area</h3><p>Discover <%= listing.location %> and nearby places.</p></div>
        </article>
        <article>
          <i class="bi bi-currency-rupee"></i>
          <div><h3>Clear nightly pricing</h3><p>See the price before you plan your stay.</p></div>
        </article>
      </section>

      <section class="detail-map-section">
        <h2>Where you’ll be</h2>
        <p><i class="bi bi-geo-alt-fill"></i> <%= listing.location %>, <%= listing.country %></p>
        <div id="map"></div>
      </section>

      <section class="review-section detail-review-form" id="reviewForm">
        <% if (currUser) { %>
          <h2>Share your experience</h2>
          <p class="detail-section-subtitle">Help other guests know what to expect.</p>
          <form method="POST" action="/listings/<%= listing._id %>/reviews" novalidate class="needs-validation">
            <fieldset class="starability-slot detail-rating-input">
              <legend>How was your stay?</legend>
              <input type="radio" id="first-rate1" name="review[rating]" value="1" required><label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2"><label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3"><label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4"><label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5"><label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <label for="comment" class="form-label">Your review</label>
            <textarea class="form-control" id="comment" name="review[comment]" rows="4" placeholder="What did you enjoy about this place?" required></textarea>
            <div class="invalid-feedback">Please add a comment before submitting.</div>
            <button type="submit" class="detail-primary-button mt-3">Post review</button>
          </form>
        <% } else { %>
          <div class="review-signin-card">
            <div><h2>Have you stayed here?</h2><p>Log in to share your experience with other guests.</p></div>
            <a href="/login" class="detail-secondary-button">Log in to review</a>
          </div>
        <% } %>
      </section>

      <section class="all-reviews detail-reviews" id="guest-reviews">
        <div class="detail-reviews-heading">
          <div>
            <h2><i class="bi bi-star-fill"></i> Guest reviews</h2>
            <p class="detail-section-subtitle">Honest thoughts from our community</p>
          </div>
          <span class="review-count"><%= listing.reviews.length %> <%= listing.reviews.length === 1 ? "review" : "reviews" %></span>
        </div>

        <% if (listing.reviews.length === 0) { %>
          <div class="empty-reviews text-center py-5">
            <i class="bi bi-chat-square-text"></i>
            <h3>Be the first to review this stay</h3>
            <p class="text-secondary mb-0">Your feedback helps future guests plan their visit.</p>
          </div>
        <% } else { %>
          <div class="row g-3">
            <% for (let review of listing.reviews) { %>
              <% const visibleReviewAuthor = review.author && !review.author.accountClosedAt ? review.author : null; %>
              <div class="col-12 col-md-6">
                <article class="guest-review-card h-100">
                  <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="review-avatar"><%= visibleReviewAuthor?.username ? visibleReviewAuthor.username.charAt(0).toUpperCase() : "G" %></div>
                    <div class="flex-grow-1 min-width-0">
                      <h3 class="reviewer-name mb-1"><%= visibleReviewAuthor ? visibleReviewAuthor.username : "Former member" %></h3>
                      <small class="review-date"><%= review.createdAt ? new Date(review.createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) : "" %></small>
                    </div>
                    <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this review?');">
                        <button type="submit" class="review-delete-btn" title="Delete review" aria-label="Delete review"><i class="bi bi-trash3"></i></button>
                      </form>
                    <% } %>
                  </div>
                  <div class="review-rating mb-2" aria-label="Rating: <%= review.rating %> out of 5">
                    <% for (let i = 1; i <= 5; i++) { %><i class="bi <%= i <= review.rating ? 'bi-star-fill' : 'bi-star' %>"></i><% } %>
                    <span class="rating-number ms-2"><%= review.rating %>/5</span>
                  </div>
                  <p class="review-message mb-0"><%= review.comment %></p>
                </article>
              </div>
            <% } %>
          </div>
        <% } %>
      </section>
    </div>

    <aside class="detail-booking-column">
      <section class="detail-price-card">
        <% if (averageRating) { %>
          <p class="detail-price-rating"><i class="bi bi-star-fill"></i> <strong><%= averageRating %></strong> · <%= listing.reviews.length %> reviews</p>
        <% } else { %>
          <p class="detail-price-rating"><i class="bi bi-stars"></i> New listing</p>
        <% } %>
        <p class="detail-price"><strong class="price-value" data-price-inr="<%= Number(listing.price || 0) %>">₹ <%= Number(listing.price || 0).toLocaleString("en-IN") %></strong> <span data-i18n="price.perNight">/ night</span></p>
        <div class="detail-price-note"><i class="bi bi-moon-stars"></i><span>Nightly rate shown to help you plan your stay.</span></div>
        <% const isListingOwner = Boolean(currUser && listing.owner && currUser._id.equals(listing.owner._id)); %>
        <% if (currUser && !isListingOwner) { %>
          <form class="stay-total-estimate" data-nightly-price="<%= Number(listing.price || 0) %>" action="/listings/<%= listing._id %>/reservations" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% } else { %>
          <div class="stay-total-estimate" data-nightly-price="<%= Number(listing.price || 0) %>">
        <% } %>
          <h3 data-i18n="price.estimateTitle">Estimate your stay</h3>
          <div class="stay-date-fields">
            <label for="checkInDate"><span data-i18n="price.checkIn">Check-in</span><input type="date" id="checkInDate" name="checkIn" required></label>
            <label for="checkOutDate"><span data-i18n="price.checkOut">Check-out</span><input type="date" id="checkOutDate" name="checkOut" required></label>
          </div>
          <label class="reservation-guests-label" for="reservationGuests">Guests</label>
          <input class="reservation-guests-input" type="number" id="reservationGuests" name="guests" min="1" max="16" value="1" required>
          <p class="stay-estimate-nights" id="stayEstimateNights" aria-live="polite" data-i18n="price.chooseDates">Choose dates to see your total.</p>
          <div class="stay-estimate-total"><span data-i18n="price.estimatedTotal">Estimated total</span><strong class="price-value" id="stayEstimateTotal" data-price-inr="0">₹ 0</strong></div>
          <p class="stay-estimate-disclaimer" data-i18n="price.estimateDisclaimer">Nightly rate × nights. Taxes and fees are not included; this is not a reservation.</p>
          <% if (currUser && !isListingOwner) { %>
            <button type="submit" class="reservation-submit-button">Continue to payment page <i class="bi bi-arrow-right"></i></button>
            <p class="reservation-inline-note">This creates a pending request. Your stay isn’t confirmed until payment and availability are set up.</p>
          <% } else if (isListingOwner) { %>
            <p class="reservation-inline-note">You can’t reserve your own listing.</p>
          <% } else { %>
            <a href="/login" class="reservation-submit-button">Log in to reserve <i class="bi bi-arrow-right"></i></a>
          <% } %>
        <% if (currUser && !isListingOwner) { %>
          </form>
        <% } else { %>
          </div>
        <% } %>
        <a href="#guest-reviews" class="detail-primary-button" data-i18n="reviews.see">See guest reviews</a>
        <p class="detail-price-footnote" data-i18n="reviews.invitation">Have a stay to share? Add your review below.</p>
      </section>
    </aside>
  </div>
</main>

<link href="https://api.mapbox.com/mapbox-gl-js/v3.16.0/mapbox-gl.css" rel="stylesheet">
<script src="https://api.mapbox.com/mapbox-gl-js/v3.16.0/mapbox-gl.js"></script>
<script>
  window.mapConfig = {
    token: <%- JSON.stringify(mapToken) %>,
    title: <%- JSON.stringify(listing.title) %>,
    coordinates: <%- JSON.stringify(coordinates) %>
  };
</script>
<script src="/JS/map.js"></script>
<script src="/JS/priceQuote.js"></script>
