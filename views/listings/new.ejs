<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-4 mb-5">
  <div class="col-lg-8 col-md-10">

    <div class="new-card p-4">

      <h2 class="mb-1 fw-bold">Create New Listing</h2>
      <p class="text-muted mb-4">
        Share your amazing place with travelers.
      </p>

      <form method="POST" action="/listings"  class="needs-validation" novalidate enctype="multipart/form-data">

        <div class="mb-3">
          <label class="form-label fw-semibold">Title</label>
          <input
            type="text"
            name="listing[title]"
            class="form-control custom-input"
            placeholder="Cozy Mountain Cabin"
            required
          >
          <div class="invalid-feedback">Title look good</div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold">Description</label>
          <textarea
            name="listing[description]"
            rows="5"
            class="form-control custom-input"
            placeholder="Describe your property..."
            required
          ></textarea>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold" for="listingCategory">Category</label>
          <select id="listingCategory" name="listing[category]" class="form-select custom-input" required>
            <% for (const category of categories) { %>
              <option value="<%= category %>" <%= category === "Other" ? "selected" : "" %>><%= category %></option>
            <% } %>
          </select>
        </div>

         <div class="mb-3">
          <label class="form-label fw-semibold">Upload Image </label>
          <input
            type="file"
            name="listing[image]"
            class="form-control custom-input"
            accept="image/png,image/jpeg"
            required
          >
        </div>


  

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label fw-semibold">Price (₹)</label>
            <input
              type="number"
              name="listing[price]"
              class="form-control custom-input"
              placeholder="2500"
              min="0"
              step="1"
              required
            >
              <div class="invalid-feedback">Please enter a valid price</div>
          </div>
                


          <div class="col-md-6 mb-3">
            <label class="form-label fw-semibold">Country</label>
            <input
              type="text"
              name="listing[country]"
              class="form-control custom-input"
              placeholder="India"
              required
            >
              <div class="invalid-feedback">Please enter a valid Country</div>
          </div>
         

        </div>

        <div class="mb-4">
          <label class="form-label fw-semibold">Location</label>
          <input
            type="text"
            name="listing[location]"
            class="form-control custom-input"
            placeholder="Varanasi, Uttar Pradesh"
            required
          >
        </div>
        <div class="invalid-feedback">Please enter a valid location</div>

        <button class="btn add-btn w-100 btn-dark">
          Add Listing
        </button>

      </form>

    </div>

  </div>
</div>

<!-- Bootstrap Classes – Quick Notes
Layout

row → Creates a horizontal grid.

col-lg-8 col-md-10 → Responsive column width.

justify-content-center → Centers the form.

Spacing

mt-4 → Top margin.

mb-3 → Space below each field.

p-4 → Padding inside the card.

w-100 → Full width.

Typography

fw-bold → Bold heading.

fw-semibold → Bold labels.

text-muted → Light gray text.

Forms

form-label → Styles labels.

form-control → Styles inputs & textarea.

Button

btn → Bootstrap button base.

w-100 → Full-width button.

Custom CSS

new-card → Rounded card with shadow.

custom-input → Rounded input + focus effect.

add-btn → Custom red button style.

Tip: Use Bootstrap for layout & spacing, and custom CSS for colors and unique design. -->
