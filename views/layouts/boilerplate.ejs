<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>WanderLust</title>

    <link rel="stylesheet" href="/css/style.css">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
        crossorigin="anonymous"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.min.css"
        crossorigin="anonymous"
        referrerpolicy="no-referrer"
    >

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200;300;400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link rel="stylesheet" href="/css/ratring.css">
</head>

<body>
    <% if (typeof hideNavbar === "undefined" || !hideNavbar) { %>
        <%- include("../includes/navbar.ejs") %>
    <% } %>

    <dialog id="preferencesDialog" class="preferences-dialog" aria-labelledby="preferencesTitle">
        <form id="preferencesForm" class="preferences-form">
            <div class="preferences-dialog-heading">
                <h2 id="preferencesTitle" data-i18n="prefs.title">Language and currency</h2>
                <button type="button" class="preferences-close" aria-label="Close" onclick="document.getElementById('preferencesDialog').close()">&times;</button>
            </div>
            <label for="preferenceLanguage" data-i18n="prefs.language">Language</label>
            <select id="preferenceLanguage" name="language">
                <option value="en">English (India)</option>
                <option value="hi">हिन्दी (भारत)</option>
            </select>
            <label for="preferenceCurrency" data-i18n="prefs.currency">Currency</label>
            <select id="preferenceCurrency" name="currency">
                <option value="INR">INR — Indian Rupee</option>
                <option value="USD">USD — US Dollar</option>
                <option value="EUR">EUR — Euro</option>
                <option value="GBP">GBP — British Pound</option>
                <option value="AED">AED — UAE Dirham</option>
            </select>
            <p id="preferencesError" class="preferences-error" role="status"></p>
            <button type="submit" class="detail-primary-button" data-i18n="prefs.save">Save preferences</button>
            <p class="preferences-rate-note">Converted amounts use approximate daily reference rates.</p>
        </form>
    </dialog>

    <main class="page-content">
        <div class="container">
            <%- include("../includes/flash.ejs") %>
            <%- body %>
        </div>
    </main>

    <%- include("../includes/footer.ejs") %>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"
    ></script>

    <script src="/JS/script.js"></script>
    <script src="/JS/navbar.js"></script>
    <script src="/JS/preferences.js"></script>
</body>
</html>
