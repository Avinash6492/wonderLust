<% layout("/layouts/boilerplate") %>

<section class="auth-page">
  <div class="account-closed-card">
    <span class="auth-mobile-mark"><i class="bi bi-shield-check"></i></span>
    <p class="auth-kicker">ACCOUNT CLOSED</p>
    <h1>Your account is closed</h1>
    <p>You’ve been signed out and can no longer log in. Your account information, profile photo, saved stays, listings, and reviews remain stored in the database. Existing listings remain visible.</p>
    <a href="/listings" class="profile-browse-link"><i class="bi bi-arrow-left"></i> Back to home</a>
  </div>
</section>
