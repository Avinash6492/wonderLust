<footer class="wanderlust-footer">
  <div class="footer-inner">
    <div class="footer-top-row">
      <a href="/listings" class="footer-brand">
        <i class="fa-regular fa-compass" aria-hidden="true"></i>
        <span>WanderLust</span>
      </a>

      <div class="footer-preferences" aria-label="Language and currency">
        <button type="button" data-open-preferences><i class="fa-solid fa-globe" aria-hidden="true"></i> <span id="footerLanguage">English (India)</span></button>
        <button type="button" data-open-preferences><i class="fa-solid fa-indian-rupee-sign" aria-hidden="true"></i> <span id="footerCurrency">INR</span></button>
      </div>
    </div>

    <div class="footer-bottom-row">
      <p class="footer-copyright">© <%= new Date().getFullYear() %> WanderLust, Inc.</p>

      <nav class="footer-legal-links" aria-label="Legal information">
        <a href="/privacy" data-i18n="footer.privacy">Privacy</a>
        <a href="/terms" data-i18n="footer.terms">Terms</a>
        <a href="/company" data-i18n="footer.company">Company details</a>
      </nav>

      <div class="footer-socials" aria-label="Social media">
        <span title="Facebook"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></span>
        <span title="X"><i class="fa-brands fa-x-twitter" aria-hidden="true"></i></span>
        <span title="Instagram"><i class="fa-brands fa-instagram" aria-hidden="true"></i></span>
      </div>
    </div>
  </div>
