NODE_ENV=development
PORT=8000
MONGO_URL=mongodb://127.0.0.1:27017/wanderLust
SECRET=replace-with-a-long-random-session-secret
MAP_BOX=your-mapbox-access-token
CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET_KEY=your-cloudinary-api-secret
RESEND_API_KEY=your-resend-api-key
RESEND_FROM="WanderLust <verification@your-verified-domain.example>"
APP_BASE_URL=https://your-app.onrender.com
SUPPORT_EMAIL=support@your-domain.example
# Payment integration is intentionally disabled. Keep secrets out of source control.
PAYMENT_PROVIDER=none
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
